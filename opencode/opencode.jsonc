{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["~/.dotfiles/assistent/opencode-skills/"],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/sunflowerair/.local/bin/browse",
          "mcp"
        ],
        "cwd": "/Users/sunflowerair",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
