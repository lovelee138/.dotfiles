font-family = Iosevka Term

keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3

# split view
keybind = ctrl+space>l=new_split:right
keybind = ctrl+space>j=new_split:down
keybind = ctrl+space>h=new_split:left
keybind = ctrl+space>k=new_split:up

keybind = alt+h=goto_split:left
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+l=goto_split:right

keybind = alt+w=close_surface

config-file = ?local.ghostty
